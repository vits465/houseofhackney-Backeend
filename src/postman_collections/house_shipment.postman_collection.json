  "item": [
    {
      "name": "Track Shipment by Number",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/shipments/track/{{trackingNumber}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "shipments",
            "track",
            "{{trackingNumber}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "List Shipments",
      "request": {
        "method": "GET",
