          "raw": "{\n  \"product\": \"{{productId}}\",\n  \"rating\": 5,\n  \"title\": \"Stunning Velvet!\",\n  \"comment\": \"The color depth and texture of this Artemis velvet exceeded my expectations.\"\n}",
