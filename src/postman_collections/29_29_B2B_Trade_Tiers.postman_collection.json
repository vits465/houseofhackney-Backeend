{
  "info": {
    "_postman_id": "mod-29",
    "name": "House of Hackney - 29. B2B Trade Tiers",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Modular collection for 29. B2B Trade Tiers"
  },
  "item": [
    {
      "name": "29. B2B Trade Tiers",
      "item": [
        {
          "name": "List Trade Tiers",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/trade/tiers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "trade",
                "tiers"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Trade Tier Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/trade/tiers/{{tierId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "trade",
                "tiers",
                "{{tradeTierId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Seed Default Tiers (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"forceReseed\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/trade/tiers/seed",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "trade",
                "tiers",
                "seed"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create Trade Tier",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"DIAMOND_VIP\",\n  \"description\": \"Exclusive tier for architectural firms with £250k+ annual volume.\",\n  \"discountPercentage\": 30,\n  \"creditLimit\": 250000,\n  \"paymentTerm\": \"NET_60\",\n  \"freeShipping\": true,\n  \"prioritySupport\": true,\n  \"status\": \"ACTIVE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/trade/tiers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "trade",
                "tiers"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "    var res = pm.response.json();",
                  "    var data = res.data || res;",
                  "    if (data._id) pm.environment.set(\"tradeTierId\", data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Update Trade Tier",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"PLATINUM\",\n  \"description\": \"Updated Platinum tier with 25% discount.\",\n  \"discountPercentage\": 25,\n  \"creditLimit\": 150000,\n  \"paymentTerm\": \"NET_60\",\n  \"freeShipping\": true,\n  \"prioritySupport\": true,\n  \"status\": \"ACTIVE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/trade/tiers/{{tierId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "trade",
                "tiers",
                "{{tradeTierId}}"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}