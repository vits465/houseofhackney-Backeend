              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "    var res = pm.response.json();",
                  "    var data = res.data || res;",
                  "    if (data._id) pm.environment.set(\"productId\", data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
