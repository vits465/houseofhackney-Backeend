  },
  "item": [
    {
      "name": "13. Product Media Bridge",
      "item": [
        {
          "name": "Get Product Media",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}/media",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "{{productId}}",
                "media"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Add Product Media",
