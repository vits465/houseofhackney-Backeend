            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product\": \"{{productId}}\",\n  \"thumbnail\": \"{{mediaId}}\",\n  \"gallery\": [\n    \"{{mediaId}}\"\n  ],\n  \"videos\": [\n    \"{{mediaId}}\"\n  ],\n  \"documents\": [\n    \"{{mediaId}}\"\n  ],\n  \"featuredImageIndex\": 0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}/media",
              "host": [
                "{{baseUrl}}"
              ],
