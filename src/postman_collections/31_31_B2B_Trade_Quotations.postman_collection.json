{
  "info": {
    "_postman_id": "mod-31",
    "name": "House of Hackney - 31. B2B Trade Quotations",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Modular collection for 31. B2B Trade Quotations"
  },
  "item": [
    {
      "name": "31. B2B Trade Quotations",
      "item": [
        {
          "name": "List Customer Quotations",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/trade/quotations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "trade",
                "quotations"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Quotation Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/trade/quotations/{{quotationId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "trade",
                "quotations",
                "{{quotationId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Request Bulk Quotation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"company\": \"{{companyId}}\",\n  \"items\": [\n    {\n      \"product\": \"{{productId}}\",\n      \"variant\": \"{{variantId}}\",\n      \"quantity\": 20,\n      \"requestedPrice\": 80\n    }\n  ],\n  \"notes\": \"Bulk trade quote for boutique hotel renovation project.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/trade/quotations/request",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "trade",
                "quotations",
                "request"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Approve Quotation",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"discount\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/trade/quotations/{{quotationId}}/approve",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "trade",
                "quotations",
                "{{quotationId}}",
                "approve"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Convert Quotation to Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shippingAddressId\": \"{{addressId}}\",\n  \"billingAddressId\": \"{{addressId}}\",\n  \"paymentMethod\": \"TRADE_CREDIT\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/trade/quotations/{{quotationId}}/convert",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "trade",
                "quotations",
                "{{quotationId}}",
                "convert"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Negotiate Quotation (Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"offeredTotalAmount\": 1500,\n  \"adminNotes\": \"Discount approved for bulk hotel project.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/trade/quotations/{{quotationId}}/negotiate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "trade",
                "quotations",
                "{{quotationId}}",
                "negotiate"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}