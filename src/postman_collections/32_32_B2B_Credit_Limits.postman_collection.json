{
  "info": {
    "_postman_id": "mod-32",
    "name": "House of Hackney - 32. B2B Credit Limits",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Modular collection for 32. B2B Credit Limits"
  },
  "item": [
    {
      "name": "32. B2B Credit Limits",
      "item": [
        {
          "name": "Get My Credit Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/trade/credits/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "trade",
                "credits",
                "me"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Set Credit Limit (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"company\": \"{{companyId}}\",\n  \"creditLimit\": 100000,\n  \"paymentTerms\": \"NET_60\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/trade/credits",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "trade",
                "credits"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}