{
  "info": {
    "_postman_id": "mod-19",
    "name": "House of Hackney - 19. Wishlist Engine",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Modular collection for 19. Wishlist Engine"
  },
  "item": [
    {
      "name": "19. Wishlist Engine",
      "item": [
        {
          "name": "Get Wishlist",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/wishlist",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "wishlist"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Add Item to Wishlist",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product\": \"{{productId}}\",\n  \"variant\": \"{{variantId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/wishlist",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "wishlist"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Remove Item from Wishlist",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/wishlist/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "wishlist",
                "{{productId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Clear Wishlist",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/wishlist",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "wishlist"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
