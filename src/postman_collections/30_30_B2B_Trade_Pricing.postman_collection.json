{
  "info": {
    "_postman_id": "mod-30",
    "name": "House of Hackney - 30. B2B Trade Pricing",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Modular collection for 30. B2B Trade Pricing"
  },
  "item": [
    {
      "name": "30. B2B Trade Pricing",
      "item": [
        {
          "name": "Get Trade Pricing by Product",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/trade/pricing/product/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "trade",
                "pricing",
                "product",
                "{{productId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Set Trade Tier Pricing (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product\": \"{{productId}}\",\n  \"tier\": \"{{tierId}}\",\n  \"tradePrice\": 85,\n  \"minimumQuantity\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/trade/pricing",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "trade",
                "pricing"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}