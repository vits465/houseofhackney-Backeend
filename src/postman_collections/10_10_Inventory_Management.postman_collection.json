{
  "info": {
    "_postman_id": "mod-10",
    "name": "House of Hackney - 10. Inventory Management",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Modular collection for 10. Inventory Management"
  },
  "item": [
    {
      "name": "10. Inventory Management",
      "item": [
        {
          "name": "Get Inventory by Product ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/inventories/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "inventories",
                "{{productId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Update Inventory Stock",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product\": \"{{productId}}\",\n  \"totalStock\": 250,\n  \"reservedStock\": 10,\n  \"warehouse\": \"WH-UK-LONDON-A1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/inventories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "inventories"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Update Inventory Record",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"totalStock\": 300\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/inventories/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "inventories",
                "{{productId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Delete Inventory",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/inventories/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "inventories",
                "{{productId}}"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}