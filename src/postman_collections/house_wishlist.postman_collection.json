            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/wishlist",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "wishlist"
          ]
        }
      },
      "response": []
    },
    {
