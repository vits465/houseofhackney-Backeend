          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "wishlist"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"product\": \"{{productId}}\",\n  \"variant\": \"{{variantId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
