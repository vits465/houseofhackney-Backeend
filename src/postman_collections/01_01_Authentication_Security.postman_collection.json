                "register"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "    var res = pm.response.json();",
                  "    var data = res.data || res;",
                  "    if (data.accessToken) pm.environment.set(\"accessToken\", data.accessToken);",
                  "    if (data.refreshToken) pm.environment.set(\"refreshToken\", data.refreshToken);",
                  "    if (data.user ? data.user._id : (data._id || null)) pm.environment.set(\"userId\", data.user ? data.user._id : (data._id || null));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
