          "raw": "{{baseUrl}}/variants",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "variants"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"product\": \"{{productId}}\",\n  \"sku\": \"HOH-ART-001-BLU\",\n  \"title\": \"Artemis Velvet - Midnight Blue\",\n  \"price\": 155,\n  \"attributes\": [\n    {\n      \"attribute\": \"Color\",\n      \"value\": \"Midnight Blue\"\n    }\n  ]\n}",
          "options": {
