  "item": [
    {
      "name": "Get Variants by Product ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/variants/product/{{productId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "variants",
            "product",
            "{{productId}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Create Variant",
      "request": {
