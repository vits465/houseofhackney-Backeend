            "body": {
              "mode": "raw",
              "raw": "{\n  \"product\": \"{{productId}}\",\n  \"variant\": \"{{variantId}}\",\n  \"rating\": 5,\n  \"title\": \"Exquisite Wallpaper Artwork!\",\n  \"comment\": \"The quality of the paper and depth of color in Artemis is unrivaled.\",\n  \"images\": [\n    \"{{mediaId}}\"\n  ],\n  \"verifiedPurchase\": true\n}",
