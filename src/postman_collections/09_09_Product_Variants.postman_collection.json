{
  "info": {
    "_postman_id": "mod-09",
    "name": "House of Hackney - 09. Product Variants",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Modular collection for 09. Product Variants"
  },
  "item": [
    {
      "name": "09. Product Variants",
      "item": [
        {
          "name": "Get Variants by Product ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/variants/product/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "variants",
                "product",
                "{{productId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create Variant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product\": \"{{productId}}\",\n  \"name\": \"Artemis - Midnight Blue / 10m Roll\",\n  \"sku\": \"ART-BLU-10M\",\n  \"price\": 160,\n  \"compareAtPrice\": 180,\n  \"stock\": 50,\n  \"attributes\": [\n    {\n      \"attribute\": \"{{attributeId}}\",\n      \"value\": \"{{attributeValueId}}\"\n    }\n  ],\n  \"status\": \"ACTIVE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/variants",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "variants"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "    var res = pm.response.json();",
                  "    var data = res.data || res;",
                  "    if (data._id) pm.environment.set(\"variantId\", data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Update Variant",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Artemis - Midnight Blue / 10m Roll Premium\",\n  \"sku\": \"ART-BLU-10M-PRM\",\n  \"price\": 175,\n  \"compareAtPrice\": 195,\n  \"stock\": 45,\n  \"status\": \"ACTIVE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/variants/{{variantId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "variants",
                "{{variantId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Delete Variant",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/variants/{{variantId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "variants",
                "{{variantId}}"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}