{
  "info": {
    "_postman_id": "mod-12",
    "name": "House of Hackney - 12. Product Pricing Matrix",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Modular collection for 12. Product Pricing Matrix"
  },
  "item": [
    {
      "name": "12. Product Pricing Matrix",
      "item": [
        {
          "name": "Get Product Pricing",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}/pricing",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "{{productId}}",
                "pricing"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create Product Pricing",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product\": \"{{productId}}\",\n  \"currency\": \"INR\",\n  \"basePrice\": 160,\n  \"sellingPrice\": 140,\n  \"compareAtPrice\": 160,\n  \"tradePrice\": 105,\n  \"minimumAdvertisedPrice\": 125,\n  \"taxClass\": \"STANDARD\",\n  \"isActive\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}/pricing",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "{{productId}}",
                "pricing"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "    var res = pm.response.json();",
                  "    var data = res.data || res;",
                  "    if (data._id) pm.environment.set(\"productId\", data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Update Product Pricing",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currency\": \"GBP\",\n  \"basePrice\": 175,\n  \"sellingPrice\": 155,\n  \"compareAtPrice\": 175,\n  \"tradePrice\": 115,\n  \"minimumAdvertisedPrice\": 135,\n  \"taxClass\": \"STANDARD\",\n  \"isActive\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}/pricing",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "{{productId}}",
                "pricing"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Delete Product Pricing",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}/pricing",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "{{productId}}",
                "pricing"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}