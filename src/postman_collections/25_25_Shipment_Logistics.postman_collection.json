  "item": [
    {
      "name": "25. Shipment & Logistics",
      "item": [
        {
          "name": "Track Shipment by Number",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/shipments/track/TRK-2026-0001",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "shipments",
                "track",
                "{{trackingNumber}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "List Shipments",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/shipments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "shipments"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Shipment by Order ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/shipments/order/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "shipments",
                "order",
                "{{orderId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create Shipment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"order\": \"{{orderId}}\",\n  \"carrier\": \"DHL Express\",\n  \"trackingNumber\": \"TRK-DHL-2026-888\",\n  \"shippingCost\": 15,\n  \"estimatedDeliveryDate\": \"2026-08-20T17:00:00.000Z\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/shipments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "shipments"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "    var res = pm.response.json();",
                  "    var data = res.data || res;",
                  "    if (data._id) pm.environment.set(\"shipmentId\", data._id);",
                  "    if (data.trackingNumber) pm.environment.set(\"trackingNumber\", data.trackingNumber);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Update Shipment Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_TRANSIT\",\n  \"location\": \"DHL Sorting Hub, East London\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/shipments/{{shipmentId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "shipments",
                "{{shipmentId}}",
                "status"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
